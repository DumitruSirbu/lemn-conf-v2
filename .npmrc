# Turn the `engines` mismatch in package.json from a WARN into a hard failure,
# for every pnpm command run anywhere in this repository.
#
# scripts/local-ci.sh checks the toolchain explicitly, but that only guards the
# push path. This guards `pnpm test`, `pnpm build`, an editor task, and the
# git hooks alike, because all of them go through pnpm. It is repository-scoped:
# other projects on this machine that still need Node 20 are unaffected.
engine-strict=true
