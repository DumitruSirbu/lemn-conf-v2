{
  "name": "lemnaria-configurator",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.15 <10"
  },
  "//scripts": "Recursive scripts run with --workspace-concurrency=1 on purpose. Several packages depend on @lemnaria/configurator-domain and each builds it via its own build:deps, so running them concurrently puts multiple tsc processes on the same dist/ and produces spurious 'error type' lint failures on a cold tree.",
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 --recursive run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ci:local": "sh scripts/local-ci.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate:boundary": "sh scripts/gates/boundary.sh",
    "gate:lockfile": "sh scripts/gates/lockfile.sh",
    "gate:sca": "pnpm audit --audit-level=high --prod",
    "lint": "pnpm --workspace-concurrency=1 --recursive run lint",
    "lint:fix": "pnpm --workspace-concurrency=1 --recursive run lint:fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm --workspace-concurrency=1 --recursive run test",
    "typecheck": "pnpm --workspace-concurrency=1 --recursive run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@fast-check/vitest": "0.3.0",
    "eslint": "9.34.0",
    "fast-check": "4.9.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.6"
  }
}
