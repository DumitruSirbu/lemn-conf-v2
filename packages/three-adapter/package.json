{
  "name": "@lemnaria/three-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:deps": "pnpm --filter @lemnaria/configurator-domain run build",
    "lint": "pnpm run build:deps && eslint . --max-warnings 0",
    "lint:fix": "pnpm run build:deps && eslint . --fix --max-warnings 0",
    "test": "pnpm run build:deps && vitest run --config vitest.config.ts",
    "typecheck": "pnpm run build:deps && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lemnaria/configurator-domain": "workspace:*",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "0.184.0"
  }
}
