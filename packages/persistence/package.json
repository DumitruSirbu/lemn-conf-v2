{
  "name": "@lemnaria/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && rm -rf dist/migrations && cp -R src/migrations dist/migrations && test \"$(ls -1 dist/migrations/*.sql | wc -l)\" -eq \"$(ls -1 src/migrations/*.sql | wc -l)\"",
    "build:deps": "pnpm --filter @lemnaria/configurator-domain run build",
    "lint": "pnpm run build:deps && eslint . --max-warnings 0",
    "lint:fix": "pnpm run build:deps && eslint . --fix --max-warnings 0",
    "migrate": "tsx src/migrate.ts",
    "test": "pnpm run build:deps && vitest run --config vitest.config.ts",
    "typecheck": "pnpm run build:deps && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lemnaria/configurator-domain": "workspace:*",
    "@neondatabase/serverless": "1.1.0",
    "nanoid": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12"
  }
}
